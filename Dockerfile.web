FROM node:24-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json

RUN npm ci --ignore-scripts

COPY apps/web apps/web

ARG STRATAAI_BUILD_REVISION=development
ARG STRATAAI_BUILD_VERSION=0.0.0-dev
ENV VITE_STRATAAI_BUILD_REVISION=$STRATAAI_BUILD_REVISION
ENV VITE_STRATAAI_BUILD_VERSION=$STRATAAI_BUILD_VERSION

RUN npm run build

FROM nginx:1.29-alpine AS runtime

ARG STRATAAI_BUILD_REVISION=development
ARG STRATAAI_BUILD_VERSION=0.0.0-dev
LABEL org.opencontainers.image.revision=$STRATAAI_BUILD_REVISION \
      org.opencontainers.image.version=$STRATAAI_BUILD_VERSION

COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY apps/web/security-headers.inc /etc/nginx/security-headers.inc
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -q -O- http://127.0.0.1/ >/dev/null || exit 1
