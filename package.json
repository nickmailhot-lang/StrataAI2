{
  "name": "strataai2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "delivery:validate": "node scripts/delivery-progress.mjs validate",
    "delivery:report": "node scripts/delivery-progress.mjs report",
    "delivery:test": "node --test tests/delivery-progress.test.mjs",
    "build": "npm --workspace @strataai/web run build",
    "test": "npm --workspace @strataai/web run test --",
    "typecheck": "npm --workspace @strataai/web run typecheck",
    "typecheck:browser": "tsc -p tsconfig.browser.json",
    "lint": "npm --workspace @strataai/web run lint"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.19.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "yaml": "2.9.1"
  }
}
