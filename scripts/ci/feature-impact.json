    "^db/",
    "^deploy/",
    "^Dockerfile",
    "^compose",
    "^\\.github/",
    "^scripts/",
    "^tests/(?!browser/)",
    "(^|/)(package(-lock)?\\.json|packages\\.lock\\.json|.*\\.csproj|.*\\.slnx|global\\.json|Directory\\..*)$",
    "^apps/web/(?!src/features/)",
    "^apps/web/src/features/(auth|organizations)/",
    "^tests/browser/(?!.*\\.spec\\.ts$)"
  ],
  "features": [
