{
  "documentationPatterns": ["^docs/", "^README\\.md$"],
  "baselineBrowser": [
    "tests/browser/board.spec.ts"
  ],
  "baselineCommands": [
    "Board visibility and role HTTP permission matrix against exact API and restricted PostgreSQL",
    "Private board discovery and revoked membership against restricted PostgreSQL runtime"
