#!/bin/sh
# Linux CI uses this read only to obtain a fresh fixture UUID. Supply the same
# CSPRNG identity on macOS; all other cat behavior remains the system command.
if [ "$#" -eq 1 ] && [ "$1" = /proc/sys/kernel/random/uuid ]; then
  exec "${STRATAAI_LOCAL_NODE:?Local Node executable is required}" -e 'process.stdout.write(require("node:crypto").randomUUID()+"\n")'
fi
exec /bin/cat "$@"
