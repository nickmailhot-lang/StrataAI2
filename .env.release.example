# Stable deployment identity: choose a unique name per environment before first
# deployment. On an existing deployment, preserve its current Compose project
# name across release directories so database/key-ring volumes stay the same.
COMPOSE_PROJECT_NAME=strataai-production
POSTGRES_DB=strataai
POSTGRES_USER=strataai
POSTGRES_PASSWORD=replace-with-a-strong-secret
STRATAAI_API_DB_PASSWORD=replace-with-a-distinct-strong-api-secret
STRATAAI_WORKER_DB_PASSWORD=replace-with-a-distinct-strong-worker-secret
# Optional separate mail role, provisioned by provision-identity-mail-role.sh.
# Set a distinct secret of at least 20 characters before running that helper.
STRATAAI_IDENTITY_DELIVERY_DB_PASSWORD=
# Required only by the API. Supply a current version and JSON base64 32-byte key ring through runtime secrets.
STRATAAI_AUTH_RETRY_CURRENT_KEY=
STRATAAI_AUTH_RETRY_KEYS=
# Authentication settings reach the API; verification policy also reaches
# Worker handlers. Empty/invalid API values are retained for startup refusal.
# Enable registration only with the intended verification/mail configuration.
STRATAAI_AUTH_ALLOW_SELF_REGISTRATION=false
STRATAAI_AUTH_REQUIRE_VERIFIED_EMAIL=true
STRATAAI_AUTH_MIN_PASSWORD_LENGTH=12
STRATAAI_AUTH_SESSION_HOURS=12
STRATAAI_AUTH_SECURITY_TOKEN_MINUTES=30
# Comma-separated Organization UUIDs for Work event delivery (maximum 100).
# Empty scope disables configured general jobs; automatic discovery loops below
# remain independent. Identity mail has its own configuration.
STRATAAI_WORKER_ORGANIZATION_IDS=
STRATAAI_ORGANIZATION_DELETION_DISCOVERY_ENABLED=true
STRATAAI_ORGANIZATION_METADATA_DISCOVERY_ENABLED=true
STRATAAI_ORGANIZATION_CONFIGURATION_DISCOVERY_ENABLED=true
STRATAAI_ORGANIZATION_OPERATIONAL_LIFECYCLE_DISCOVERY_ENABLED=true
STRATAAI_INVITATION_RECIPIENT_AUTHORITY_DISCOVERY_ENABLED=true
STRATAAI_INVITATION_ISSUER_AUTHORITY_DISCOVERY_ENABLED=true
# Optional invitation mail, default false. Requires configured identity mail
# transport/key ring in both API and Worker and a scoped Worker for each tenant.
STRATAAI_INVITATION_EMAIL_ENABLED=false
# Optional verification/account-recovery mail. Complete the shared settings and
# provision the dedicated mail role before enabling; see the release README.
# Use the exact HTTPS public origin, a plain sender address, provider account,
# and a current key ID with a JSON ring of base64-encoded 32-byte random keys.
STRATAAI_IDENTITY_EMAIL_ENABLED=false
STRATAAI_IDENTITY_EMAIL_FROM=
STRATAAI_PUBLIC_ORIGIN=
STRATAAI_IDENTITY_EMAIL_ACCOUNT=
STRATAAI_IDENTITY_TOKEN_CURRENT_KEY=
STRATAAI_IDENTITY_TOKEN_KEYS=
# Worker-only provider secret and correctly encoded Npgsql connection string
# for strataai_identity_mail_runtime; match STRATAAI_IDENTITY_DELIVERY_DB_PASSWORD above.
STRATAAI_IDENTITY_EMAIL_API_KEY=
STRATAAI_IDENTITY_DELIVERY_CONNECTION_STRING=
# Exact browser origin (scheme, host, port) for SignalR, e.g. https://app.example.test.
STRATAAI_REALTIME_PUBLIC_ORIGIN=

STRATAAI_WEB_IMAGE=strataai-web:replace-with-ci-sha
STRATAAI_API_IMAGE=strataai-api:replace-with-ci-sha
STRATAAI_WORKER_IMAGE=strataai-worker:replace-with-ci-sha

# Optional external OTLP HTTP metrics receiver, full URL ending /v1/metrics.
# With compose.metrics.yml, an unset endpoint selects its private receiver.
STRATAAI_METRICS_OTLP_ENDPOINT=
STRATAAI_METRICS_OTLP_HEADERS=
