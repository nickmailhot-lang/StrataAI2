POSTGRES_DB=strataai
POSTGRES_USER=strataai
POSTGRES_PASSWORD=replace-with-a-strong-secret
STRATAAI_API_DB_PASSWORD=replace-with-a-distinct-strong-api-secret
STRATAAI_WORKER_DB_PASSWORD=replace-with-a-distinct-strong-worker-secret
# Required only by the API. Supply a current version and JSON base64 32-byte key ring through runtime secrets.
STRATAAI_AUTH_RETRY_CURRENT_KEY=
STRATAAI_AUTH_RETRY_KEYS=
# Comma-separated Organization UUIDs for Work event delivery (maximum 100).
# Empty scope disables Organization jobs; identity mail has its own configuration.
STRATAAI_WORKER_ORGANIZATION_IDS=
# Optional invitation mail, default false. Requires configured identity mail
# transport/key ring in both API and Worker and a scoped Worker for each tenant.
STRATAAI_INVITATION_EMAIL_ENABLED=false
# Exact browser origin (scheme, host, port) for SignalR, e.g. https://app.example.test.
STRATAAI_REALTIME_PUBLIC_ORIGIN=

STRATAAI_WEB_IMAGE=strataai-web:replace-with-ci-sha
STRATAAI_API_IMAGE=strataai-api:replace-with-ci-sha
STRATAAI_WORKER_IMAGE=strataai-worker:replace-with-ci-sha
