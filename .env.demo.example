# Copy to .env.demo and use the three retained tags from build-metadata.json.
COMPOSE_PROJECT_NAME=strataai-demo
STRATAAI_WEB_IMAGE=strataai-web:replace-with-ci-sha
STRATAAI_API_IMAGE=strataai-api:replace-with-ci-sha
STRATAAI_WORKER_IMAGE=strataai-worker:replace-with-ci-sha
# Optional local web port; update the matching public origin when changing it.
STRATAAI_DEMO_WEB_PORT=8088
STRATAAI_DEMO_PUBLIC_ORIGIN=http://localhost:8088
