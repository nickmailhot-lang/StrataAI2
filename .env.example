POSTGRES_DB=strataai
POSTGRES_USER=strataai
POSTGRES_PASSWORD=change-me-for-local-development
STRATAAI_RUNTIME_MODE=demo
# Build-time values for local Docker builds; runtime hosts ignore these variables.
STRATAAI_BUILD_REVISION=development
STRATAAI_BUILD_VERSION=0.0.0-dev

# Authentication defaults shown for local/demo use.
STRATAAI_AUTH_ALLOW_SELF_REGISTRATION=true
STRATAAI_AUTH_REQUIRE_VERIFIED_EMAIL=false
STRATAAI_AUTH_MIN_PASSWORD_LENGTH=12
STRATAAI_AUTH_SESSION_HOURS=12
STRATAAI_AUTH_SECURITY_TOKEN_MINUTES=30

# Production identity email is optional and fails uniformly as unavailable when disabled.
# Supply runtime secrets through your deployment secret manager; never commit them.
STRATAAI_IDENTITY_EMAIL_ENABLED=false
STRATAAI_IDENTITY_EMAIL_FROM=
STRATAAI_PUBLIC_ORIGIN=
STRATAAI_IDENTITY_EMAIL_ACCOUNT=
STRATAAI_IDENTITY_TOKEN_CURRENT_KEY=
STRATAAI_IDENTITY_TOKEN_KEYS=
STRATAAI_IDENTITY_EMAIL_API_KEY=
STRATAAI_IDENTITY_DELIVERY_CONNECTION_STRING=
