FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src

COPY global.json Directory.Build.props Directory.Build.targets Directory.Packages.props ./
COPY src/StrataAI.Domain/StrataAI.Domain.csproj src/StrataAI.Domain/
COPY src/StrataAI.Application/StrataAI.Application.csproj src/StrataAI.Application/
COPY src/StrataAI.Infrastructure/StrataAI.Infrastructure.csproj src/StrataAI.Infrastructure/
COPY src/StrataAI.Worker/StrataAI.Worker.csproj src/StrataAI.Worker/
COPY src/StrataAI.Domain/packages.lock.json src/StrataAI.Domain/
COPY src/StrataAI.Application/packages.lock.json src/StrataAI.Application/
COPY src/StrataAI.Infrastructure/packages.lock.json src/StrataAI.Infrastructure/
COPY src/StrataAI.Worker/packages.lock.json src/StrataAI.Worker/

RUN dotnet restore src/StrataAI.Worker/StrataAI.Worker.csproj --locked-mode

COPY src src

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev \
    && cc -std=c11 -O2 -Wall -Wextra -Werror src/StrataAI.Worker/native/preview-launcher.c -o /tmp/strata-preview-launcher \
    && rm -rf /var/lib/apt/lists/*

ARG STRATAAI_BUILD_REVISION=development
ARG STRATAAI_BUILD_VERSION=0.0.0-dev

RUN dotnet publish src/StrataAI.Worker/StrataAI.Worker.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    -p:SourceRevisionId=$STRATAAI_BUILD_REVISION \
    -p:Version=$STRATAAI_BUILD_VERSION

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

ARG STRATAAI_BUILD_REVISION=development
ARG STRATAAI_BUILD_VERSION=0.0.0-dev
ARG STRATAAI_BUILD_SOURCE
ARG STRATAAI_BUILD_CREATED
LABEL org.opencontainers.image.revision=$STRATAAI_BUILD_REVISION \
      org.opencontainers.image.version=$STRATAAI_BUILD_VERSION \
      org.opencontainers.image.source=$STRATAAI_BUILD_SOURCE \
      org.opencontainers.image.created=$STRATAAI_BUILD_CREATED

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/publish .
COPY --from=build /tmp/strata-preview-launcher /app/strata-preview-launcher

ENV ASPNETCORE_URLS=http://+:8081
EXPOSE 8081

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=5 \
  CMD curl --fail --silent --show-error http://127.0.0.1:8081/healthz || exit 1

ENTRYPOINT ["dotnet", "StrataAI.Worker.dll"]
